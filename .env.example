# ===== AI 模型配置 =====
# provider: mock = 本地规则引擎（无需 key，开箱即用）
#            openai = OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / Kimi / 火山豆包 均可）
AI_PROVIDER=mock
# 各家 OpenAI 兼容接口地址与模型名示例：
#   DeepSeek   AI_BASE_URL=https://api.deepseek.com/v1        AI_MODEL=deepseek-chat
#   通义千问    AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
#   智谱 GLM   AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  AI_MODEL=glm-4-flash
#   Kimi       AI_BASE_URL=https://api.moonshot.cn/v1        AI_MODEL=moonshot-v1-8k
#   火山豆包   AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  AI_MODEL=<推理接入点ID>
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# ===== Dify 平台接入（可选） =====
# 配了 DIFY_APP_TOKEN 后，对话式起名优先走 Dify Chatflow（可视化 Agent + 知识库 + 模型管理），
# 失败时自动回退到上面的直连模型或本地引擎。云版默认 https://api.dify.ai/v1，自托管填你的地址。
# Dify 端约定：LLM 节点按 {"reply":"...","names":[...],"ask":"..."} 输出 JSON，直接回复节点引用 LLM 的 text。
DIFY_BASE_URL=
DIFY_APP_TOKEN=

# ===== 服务配置 =====
PORT=3000
# 每 IP 每分钟最大请求数
RATE_LIMIT=30
# 后台管理令牌：留空 = 本地开放；部署到服务器时务必设置（例如 openssl rand -hex 16）
ADMIN_TOKEN=
# SQLite 数据库文件路径（默认项目目录下 petname.db；部署时建议指向持久化卷）
DB_PATH=
